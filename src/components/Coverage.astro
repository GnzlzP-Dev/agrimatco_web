---
const coverage = [
  {
    department: 'Antioquia',
    badge: 'Sede Central Medellín',
    subregions: [
      { name: 'Oriente 1', towns: ['La Unión', 'Abejorral', 'La Ceja', 'El Carmen', 'Sonsón'] },
      { name: 'Oriente 2', towns: ['Guarne', 'San Vicente', 'Marinilla', 'Santuario', 'El Peñol', 'Rionegro'] },
      { name: 'Norte', towns: ['Santa Rosa', 'Yarumal', 'Entrerríos', 'San Pedro', 'Angostura'] },
    ],
  },
  {
    department: 'Cundinamarca',
    badge: 'Región Central',
    subregions: [
      { name: 'Sumapaz', towns: ['Sibaté', 'Fusagasugá', 'Subía', 'Silvania', 'Pasca'] },
      { name: 'Sabana', towns: ['Mosquera', 'Subachoque', 'Facatativá'] },
    ],
  },
  {
    department: 'Huila',
    badge: 'Región Sur',
    subregions: [
      { name: 'Neiva y municipios aledaños', towns: ['Neiva', 'Rivera', 'Pitalito'] },
    ],
  },
];
---

<section id="cobertura" class="relative before:absolute before:inset-0 
            before:bg-[url(/mapa-invert.jpeg)] before:bg-cover before:bg-center before:bg-no-repeat 
            before:opacity-70 py-16 md:py-24 overflow-hidden scroll-mt-10">
  <div class="absolute bottom-0 left-0 w-full h-60 bg-gradient-to-t from-gray-50 to-transparent pointer-events-none z-0"></div>
  <div class="absolute top-0 left-0 w-full h-60 bg-gradient-to-b from-gray-50 to-transparent pointer-events-none z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="max-w-2xl mb-12">
      <span class="text-brand-green text-xs sm:text-sm font-bold tracking-widest uppercase block mb-2">
        Expansión Estratégica
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#111827] tracking-tight">
        Cobertura y Presencia Agrimatco: <span class="text-white bg-brand-green px-5">Siempre cerca de tu región</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {coverage.map((dep) => (
        <div class="bg-white rounded-2xl border border-gray-100 p-6 sm:p-7 shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5">
            <div class="flex items-center gap-2.5">
              <div class="w-3 h-3 rounded-full bg-brand-green"></div>
              <h3 class="text-lg font-bold text-[#111827]">{dep.department}</h3>
            </div>
            <span class="px-2.5 py-1 rounded bg-brand-green/10 text-brand-green text-[10px] font-bold tracking-wide uppercase whitespace-nowrap">
              {dep.badge}
            </span>
          </div>

          <div class="space-y-4">
            {dep.subregions.map((sub) => (
              <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
                <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wide mb-2">{sub.name}</h4>
                <div class="flex flex-wrap gap-1.5">
                  {sub.towns.map((town) => (
                    <span class="text-[11px] font-medium text-[#4B5563] bg-white border border-gray-200 rounded-full px-2.5 py-1">
                      {town}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>