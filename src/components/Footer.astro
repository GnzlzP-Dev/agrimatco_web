---
---
<footer id="contacto" class="relative bg-brand-dark text-gray-300 pt-16 pb-8 overflow-hidden border-t-4 border-brand-green scroll-mt-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start pb-12 border-b border-gray-800">
      
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-white text-2xl font-extrabold tracking-tight block">
            AGRIMATCO<span class="text-brand-green">.</span>
          </span>
          <span class="text-xs uppercase tracking-widest text-brand-green font-bold block mt-1">
            Nutrición Vegetal de Alta Eficiencia
          </span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed max-w-sm">
          Impulsando la rentabilidad y productividad del agro colombiano mediante la línea premium de fertilizantes en pasta Amcopaste.
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-3">
            <div class="p-2 rounded bg-gray-800 text-brand-green mt-0.5 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Razón Social</p>
              <p class="text-sm text-white font-medium">Agrimatco Colombia S.A.S.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="p-2 rounded bg-gray-800 text-brand-green mt-0.5 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Oficina de Operaciones</p>
              <p class="text-sm text-white font-medium">Itagui, Antioquia, Colombia</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 w-full">
        <div class="relative bg-gray-800 rounded-xl overflow-hidden border border-gray-700 shadow-inner group">
           <!--<div class="absolute top-3 right-3 z-10 bg-[#111827]/90 backdrop-blur-sm px-3 py-1.5 rounded-lg border border-gray-700 text-xs text-white font-medium flex items-center gap-2 pointer-events-none">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Centro de Operación Central
          </div>-->
          <div class="w-full aspect-[16/10] sm:aspect-[16/8] lg:aspect-[16/9]">

            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3968.3468853864833!2d-75.5895417!3d6.188607799999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e4683006c9e50c9%3A0x1881d369388ef15!2sAgrimatco%20Colombia%20SAS!5e0!3m2!1ses!2sco!4v1784574748158!5m2!1ses!2sco"
              class="w-full h-full border-0 grayscale-[40%] contrast-[110%] opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="strict-origin-when-cross-origin"
              title="Ubicación Agrimatco Colombia">
            </iframe>
            <!--
            <iframe 
              src="https://maps.google.com/maps?q=Central%20Mayorista%20Itagui%20Antioquia&t=&z=15&ie=UTF8&iwloc=&output=embed" 
              class="w-full h-full border-0 grayscale-[40%] contrast-[110%] opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación Agrimatco Colombia">
            </iframe>
            -->
          </div>
        </div>
      </div>

      <!-- Divisiones de contacto por zonas -->
      <div class="lg:col-span-12 w-full">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mt-12">
          <div class="bg-gray-800 rounded-xl p-6 sm:p-8 border border-gray-700 shadow-sm hover:shadow-md transition-shadow duration-300">
            <h3 class="text-lg sm:text-xl font-bold text-white mb-3">Región Norte y Oriente Antioqueño</h3>
             <p class="text-xs sm:text-sm  leading-relaxed mb-4">
              <strong>Asesor:</strong> Federico Delgado
            </p>
            <p class="text-xs sm:text-sm  leading-relaxed mb-4"><strong>Dirección:</strong> Calle 123 #45-67, Medellín, Colombia</p>
            <a href="tel:+573103456789" class="inline-flex items-center gap-2 text-brand-green font-semibold text-sm sm:text-base hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +57 (310) XXX XXXX
            </a>
          </div>

          <!-- Additional contact zones can be added here -->
           <div class="bg-gray-800 rounded-xl p-6 sm:p-8 border border-gray-700 shadow-sm hover:shadow-md transition-shadow duration-300">
            <h3 class="text-lg sm:text-xl font-bold text-white mb-3">Región Centro</h3>
            <p class="text-xs sm:text-sm  leading-relaxed mb-4">
              <strong>Asesor:</strong> Federico Delgado
            </p>
            <p class="text-xs sm:text-sm  leading-relaxed mb-4"><strong>Dirección:</strong> Calle 123 #45-67, Medellín, Colombia</p>
            <a href="tel:+573103456789" class="inline-flex items-center gap-2 text-brand-green font-semibold text-sm sm:text-base hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +57 (310) XXX XXXX
            </a>
          </div>
          <div class="bg-gray-800 rounded-xl p-6 sm:p-8 border border-gray-700 shadow-sm hover:shadow-md transition-shadow duration-300">
            <h3 class="text-lg sm:text-xl font-bold text-white mb-3">Región Suroeste y Urabá</h3>
             <p class="text-xs sm:text-sm  leading-relaxed mb-4">
              <strong>Asesor:</strong> Federico Delgado
            </p>
            <p class="text-xs sm:text-sm  leading-relaxed mb-4"><strong>Dirección:</strong> Calle 123 #45-67, Medellín, Colombia</p>
            <a href="tel:+573103456789" class="inline-flex items-center gap-2 text-brand-green font-semibold text-sm sm:text-base hover:underline">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +57 (310) XXX XXXX
            </a>
          </div>
        </div>
      </div>

    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>© {new Date().getFullYear()} Agrimatco Colombia S.A.S. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>