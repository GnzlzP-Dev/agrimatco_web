  class="fixed inset-y-0 right-0 w-[280px] sm:w-[320px] bg-gray-950/98 backdrop-blur-md z-40 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col justify-between pt-28 pb-8 px-6 border-l border-white/10"
>
  <nav class="flex flex-col gap-6 text-base font-medium text-gray-200 mobile-nav-links">
    <a href="#servicios" class="hover:text-emerald-400 border-b border-white/5 pb-2 transition-colors">Servicios</a>
    <a href="#cobertura" class="hover:text-emerald-400 border-b border-white/5 pb-2 transition-colors">Cobertura</a>
    <a href="#productos" class="hover:text-emerald-400 border-b border-white/5 pb-2 transition-colors">Productos</a>
    <a href="#faq" class="hover:text-emerald-400 border-b border-white/5 pb-2 transition-colors">FAQ</a>
    <a href="#contacto" class="bg-[#007A48] hover:bg-[#00633a] text-white px-5 py-3 rounded-lg text-center font-bold transition-all mt-4">Contacto</a>
  </nav>

  <div class="text-xs text-gray-500 text-center">
    Agrimatco Colombia S.A.S.
  </div>
</div>

<div id="drawer-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-30 hidden opacity-0 transition-opacity duration-300 md:hidden"></div>

