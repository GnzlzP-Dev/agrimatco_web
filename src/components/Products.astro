---
import Acmopaste20_50_10 from '../images/products/20-50-10.png';
import Acmopaste5_50_30 from '../images/products/5-50-30.png';
import Acmopaste20_20_20 from '../images/products/20-20-20.png';


---
<section id="productos" class="relative bg-white py-16 md:py-24 overflow-hidden border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[#007A48] text-xs sm:text-sm font-bold tracking-widest uppercase block mb-2">
        Portafolio de Alta Tecnología
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#111827] tracking-tight mb-4">
        Línea Amcopaste: <span class="text-[#007A48]">Nutrición Inteligente en Pasta</span>
      </h2>
      <p class="text-sm sm:text-base text-[#6B7280] leading-relaxed">
        La estructura física única de <strong>Amcopaste</strong> ofrece una solubilidad superior y una asimilación inmediata, adaptándose a cualquier tipo de cultivo. Fusión de alta concentración y dosificación precisa limpia, imitando los estándares de empaque premium globales.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      <div class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
        <div>
          <img src={Acmopaste20_50_10.src} alt="Amcopaste 20-50-10 + TE" class="w-full"/>
          <!--
          <div class="w-full aspect-[4/5] bg-white rounded-xl border border-gray-100 flex items-center justify-center p-4 mb-4 relative overflow-hidden group-hover:border-emerald-200 transition-colors">
            <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-emerald-500/5 to-transparent"></div>
            <div class="w-32 h-44 bg-gradient-to-b from-gray-50 to-gray-100 rounded-lg border-2 border-dashed border-gray-300 relative flex flex-col justify-between p-3 shadow-inner">
              <span class="text-[9px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded self-start">AMCOPASTE</span>
              <div class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mx-auto text-emerald-600 font-bold text-xs shadow-sm">20-50-10</div>
              <div class="h-1.5 w-full bg-emerald-500 rounded-full"></div>
            </div>
          </div>
          -->
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            20-50-10 + TE
          </div>
          <h3 class="text-lg font-bold text-[#111827] group-hover:text-[#007A48] transition-colors duration-200 mb-2">Amcopaste Enraizamiento</h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fertilizante en pasta de alta densidad con una concentración masiva de fósforo asimilable.
          </p>
        </div>
        <div class="mt-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">Etapas iniciales, trasplante y renovación radicular.</p>
        </div>
      </div>

      <div class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
        <div>
          <img src={Acmopaste5_50_30.src} alt="Amcopaste 5-50-30 + TE" class="w-full"/>
          <!--
          <div class="w-full aspect-[4/5] bg-white rounded-xl border border-gray-100 flex items-center justify-center p-4 mb-4 relative overflow-hidden group-hover:border-rose-200 transition-colors">
            <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-rose-500/5 to-transparent"></div>
            <div class="w-32 h-44 bg-gradient-to-b from-gray-50 to-gray-100 rounded-lg border-2 border-dashed border-gray-300 relative flex flex-col justify-between p-3 shadow-inner">
              <span class="text-[9px] font-bold text-rose-700 bg-rose-50 border border-rose-200 px-1.5 py-0.5 rounded self-start">AMCOPASTE</span>
              <div class="w-12 h-12 rounded-full bg-rose-500/10 border border-rose-500/30 flex items-center justify-center mx-auto text-rose-600 font-bold text-xs shadow-sm">5-50-30</div>
              <div class="h-1.5 w-full bg-rose-500 rounded-full"></div>
            </div>
          </div>
          -->
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
            5-50-30 + TE
          </div>
          <h3 class="text-lg font-bold text-[#111827] group-hover:text-[#007A48] transition-colors duration-200 mb-2">Amcopaste Floración</h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fórmula cargada con un alto balance de fósforo y potasio altamente solubles.
          </p>
        </div>
        <div class="mt-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">Prefloración, floración abierta y cuaje del fruto.</p>
        </div>
      </div>

      <div class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
        <div>
          <img src={Acmopaste20_20_20.src} alt="Amcopaste 20-20-20 + TE" class="w-full"/>
          <!--
          <div class="w-full aspect-[4/5] bg-white rounded-xl border border-gray-100 flex items-center justify-center p-4 mb-4 relative overflow-hidden group-hover:border-blue-200 transition-colors">
            <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-blue-500/5 to-transparent"></div>
            <div class="w-32 h-44 bg-gradient-to-b from-gray-50 to-gray-100 rounded-lg border-2 border-dashed border-gray-300 relative flex flex-col justify-between p-3 shadow-inner">
              <span class="text-[9px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-1.5 py-0.5 rounded self-start">AMCOPASTE</span>
              <div class="w-12 h-12 rounded-full bg-blue-500/10 border border-blue-500/30 flex items-center justify-center mx-auto text-blue-600 font-bold text-xs shadow-sm">20-20-20</div>
              <div class="h-1.5 w-full bg-blue-500 rounded-full"></div>
            </div>
          </div>
          -->

          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            20-20-20 + TE
          </div>
          <h3 class="text-lg font-bold text-[#111827] group-hover:text-[#007A48] transition-colors duration-200 mb-2">Amcopaste Balance</h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fórmula equilibrada de NPK en partes iguales, enriquecida con micronutrientes.
          </p>
        </div>
        <div class="mt-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">Crecimiento vegetativo y desarrollo foliar continuo.</p>
        </div>
      </div>

      <div class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
        <div>
          <img src="src/images/products/15-20-50.png" alt="Amcopaste 15-20-50 + TE"/>
          <!--
          <div class="w-full aspect-[4/5] bg-white rounded-xl border border-gray-100 flex items-center justify-center p-4 mb-4 relative overflow-hidden group-hover:border-purple-200 transition-colors">
            <div class="absolute bottom-0 inset-x-0 h-16 bg-gradient-to-t from-purple-500/5 to-transparent"></div>
            <div class="w-32 h-44 bg-gradient-to-b from-gray-50 to-gray-100 rounded-lg border-2 border-dashed border-gray-300 relative flex flex-col justify-between p-3 shadow-inner">
              <span class="text-[9px] font-bold text-purple-700 bg-purple-50 border border-purple-200 px-1.5 py-0.5 rounded self-start">AMCOPASTE</span>
              <div class="w-12 h-12 rounded-full bg-purple-500/10 border border-purple-500/30 flex items-center justify-center mx-auto text-purple-600 font-bold text-xs shadow-sm">15-20-50</div>
              <div class="h-1.5 w-full bg-purple-500 rounded-full"></div>
            </div>
          </div>
          -->
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-purple-50 border border-purple-200 text-purple-700 text-xs font-bold uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
            15-20-50 + TE
          </div>
          <h3 class="text-lg font-bold text-[#111827] group-hover:text-[#007A48] transition-colors duration-200 mb-2">Amcopaste Llenado</h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fertilizante en pasta con una concentración extrema de potasio soluble.
          </p>
        </div>
        <div class="mt-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">Fases de fructificación, engorde y maduración final.</p>
        </div>
      </div>
    </div>
  </div>
</section>