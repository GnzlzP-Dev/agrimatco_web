---
import { cloudinaryImageUrl, type GalleryEntry } from '../../data/gallery';

interface Props {
  items: GalleryEntry[];
}

const { items } = Astro.props;

// Las primeras filas son las visibles al cargar: sin lazy para no penalizar el LCP.
const PRIORITY_COUNT = 8;

const payload = items.map((item) => ({
  title: item.title,
  alt: item.alt,
  fullSrc: item.fullSrc,
  fullWidth: item.fullWidth,
  fullHeight: item.fullHeight,
}));
const safePayload = JSON.stringify(payload).replace(/</g, '\\u003c');
---

{
  items.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-20 text-center">
      <p class="text-sm leading-relaxed text-gray-500">
        Todavía no hay contenido en la galería.
        Sube imágenes a la carpeta <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs">AGRIMATCO</code>
        de Cloudinary para que aparezcan aquí.
      </p>
    </div>
  ) : (
    <>
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-4">
        {items.map((item, i) => (
          <div class="mb-4 break-inside-avoid">
            <button
              type="button"
              class="group relative block w-full overflow-hidden rounded-xl bg-gray-100 shadow-sm ring-1 ring-gray-200/70 transition-shadow duration-300 hover:shadow-xl hover:shadow-black/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2"
              data-gallery-open={i}
              aria-label={`Ampliar ${item.title}`}
            >
              <img
                src={cloudinaryImageUrl(item.secureUrl, 960)}
                srcset={[400, 640, 960, 1280]
                  .map((width) => `${cloudinaryImageUrl(item.secureUrl, width)} ${width}w`)
                  .join(', ')}
                sizes="(min-width:1280px) 300px, (min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw"
                width={item.width}
                height={item.height}
                loading={i < PRIORITY_COUNT ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i < PRIORITY_COUNT ? 'high' : 'auto'}
                alt={item.alt}
                class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.04]"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-black/75 to-transparent px-3 pb-3 pt-8 text-left text-sm font-semibold text-white opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                {item.title}
              </span>
            </button>
          </div>
        ))}
      </div>

      <script type="application/json" id="gallery-data" set:html={safePayload} is:inline />
    </>
  )
}
