---
import { Image } from 'astro:assets';
import { asset, type GalleryItem } from '../../data/gallery';

interface Props {
  item: GalleryItem;
  index: number;
  priority?: boolean;
}

const { item, index, priority = false } = Astro.props;

const isVideo = item.type === 'video';
const poster = isVideo ? (item.poster ?? item.file) : item.file;
const meta = asset(poster);
const title = item.title ?? item.alt;
---

<button
  type="button"
  class="group relative block w-full overflow-hidden rounded-xl bg-gray-100 shadow-sm ring-1 ring-gray-200/70 transition-shadow duration-300 hover:shadow-xl hover:shadow-black/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2"
  data-gallery-open={index}
  aria-label={`Ampliar ${title}`}
>
  <div class="relative">
    <Image
      src={meta}
      widths={[400, 640, 960, 1280]}
      sizes="(min-width:1280px) 300px, (min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
      alt={item.alt}
      class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.04]"
    />

    {
      isVideo && (
        <div class="absolute inset-0" data-video-tile data-index={index}>
          <div class="absolute inset-0" data-video-holder />
        </div>
      )
    }

    {
      isVideo && (
        <span
          data-play-overlay
          class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors duration-300 group-hover:bg-black/30"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/95 shadow-xl transition-transform duration-300 group-hover:scale-110">
            <svg class="ml-1 h-6 w-6 fill-brand-green" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="absolute left-3 top-3 rounded-md bg-black/70 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-white">
            Video
          </span>
        </span>
      )
    }

    {
      title && (
        <span class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-black/75 to-transparent px-3 pb-3 pt-8 text-left text-sm font-semibold text-white opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
          {title}
        </span>
      )
    }
  </div>
</button>
