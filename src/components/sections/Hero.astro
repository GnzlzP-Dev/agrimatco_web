---
import { Image } from 'astro:assets';
import groundNature from '../../assets/backgrounds/ground-nature.jpeg';

const section = (anchor: string) => (Astro.url.pathname === '/' ? anchor : `/${anchor}`);
---

<section class="relative min-h-[90vh] md:min-h-screen w-full flex items-center justify-center bg-brand-dark overflow-hidden">

  <div class="absolute inset-0 z-0">
    <Image
      src={groundNature}
      alt="Campos agrícolas y logística de distribución al amanecer"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      priority
      class="w-full h-full object-cover object-center scale-105 animate-subtle-zoom"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-brand-dark/75 to-transparent"></div>
    <div class="absolute bottom-0 left-0 w-full h-50 bg-gradient-to-t from-[#F9FAFB] to-transparent pointer-events-none z-0"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 pt-32 pb-16 md:pt-40 md:pb-24">
    <div class="md:max-w-3xl max-w-2xl  text-left">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-green/20 backdrop-blur-md text-white text-xs sm:text-sm font-bold tracking-wide uppercase mb-6 border border-brand-green/30">
        <span class="w-2 h-2 rounded-full bg-brand-green animate-pulse"></span>
        Nutrición Vegetal de Vanguardia en Colombia
      </span>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.12] mb-6">
        Fertilizantes en Pasta y Nutrición Vegetal  <span class="text-brand-green block sm:inline">en Colombia</span>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-gray-300 leading-relaxed md:max-w-3xl max-w-2xl mb-8 font-light pr-20 md:p-0">
        Traemos a Colombia la línea premium <strong class="text-white font-semibold">Cultivar paste</strong>. Acompañamos tu cosecha en Antioquia, Cundinamarca y Huila con visitas técnicas, diagnóstico y parcelas de prueba sin costo.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={section('#contact-form')}
          class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-4 rounded-lg bg-brand-green   hover:bg-[#00633a] text-white font-bold text-sm sm:text-base transition-all duration-300 shadow-xl shadow-emerald-950/30 hover:-translate-y-0.5 group"
        >
          Solicitar Asesoría y Pruebas
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:w-5 sm:w-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href={section('#productos')}
          class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-4 rounded-lg bg-white/10 hover:bg-white/20 text-white backdrop-blur-sm border border-white/20 font-semibold text-sm sm:text-base transition-all duration-300"
        >
          Ver Productos
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes subtleZoom {
    0% { transform: scale(1.02); }
    100% { transform: scale(1.06); }
  }
  .animate-subtle-zoom {
    animation: subtleZoom 20s infinite alternate ease-in-out;
  }
</style>
