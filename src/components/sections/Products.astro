---
import { Image } from "astro:assets";
import enraizamiento from "../../assets/products/20-50-10.png";
import floracion from "../../assets/products/5-50-30.png";
import balanceado from "../../assets/products/20-20-20.png";
import llenado from "../../assets/products/15-20-50.png";

const R2_URL = import.meta.env.PUBLIC_R2_URL;

// Una sola fuente de datos para las tarjetas. Las clases de color van completas
// (no armadas con plantillas) para que Tailwind las detecte al compilar.
const products = [
  {
    npk: "20-50-10 + TE",
    name: "Enraizamiento",
    image: enraizamiento,
    description:
      "Fertilizante en pasta de alta densidad con una concentración masiva de fósforo asimilable.",
    application: "Etapas iniciales, trasplante y renovación radicular.",
    pdf: "20 50 10 datasheet ES.pdf",
    badge: "bg-emerald-50 border-emerald-200 text-emerald-700",
    dot: "bg-emerald-500",
  },
  {
    npk: "5-50-30 + TE",
    name: "Floración",
    image: floracion,
    description:
      "Fórmula cargada con un alto balance de fósforo y potasio altamente solubles.",
    application: "Prefloración, floración abierta y cuaje del fruto.",
    pdf: "5 50 30 datasheet ES.pdf",
    badge: "bg-rose-50 border-rose-200 text-rose-700",
    dot: "bg-rose-500",
  },
  {
    npk: "20-20-20 + TE",
    name: "Balanceado",
    image: balanceado,
    description:
      "Fórmula equilibrada de NPK en partes iguales, enriquecida con micronutrientes.",
    application: "Crecimiento vegetativo y desarrollo foliar continuo.",
    pdf: "20 20 20 datasheet ES.pdf",
    badge: "bg-blue-50 border-blue-200 text-blue-700",
    dot: "bg-blue-500",
  },
  {
    npk: "15-20-50 + TE",
    name: "Llenado",
    image: llenado,
    description:
      "Fertilizante en pasta con una concentración extrema de potasio soluble.",
    application: "Fases de fructificación, engorde y maduración final.",
    pdf: "15 20 50 datasheet ES.pdf",
    badge: "bg-purple-50 border-purple-200 text-purple-700",
    dot: "bg-purple-500",
  },
];
---

<section
  id="productos"
  class="relative bg-white py-16 md:py-24 overflow-hidden scroll-mt-10"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-brand-green text-xs sm:text-sm font-bold tracking-widest uppercase block mb-2"
      >
        Portafolio de Alta Tecnología
      </span>
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-ink tracking-tight mb-4"
      >
        Línea Cultivar paste: <span class="text-brand-green"
          >Nutrición Inteligente en Pasta</span
        >
      </h2>
      <p class="text-sm sm:text-base text-muted leading-relaxed">
        La estructura física única de <strong>Cultivar paste</strong> ofrece una solubilidad
        superior y una asimilación inmediata, adaptándose a cualquier tipo de cultivo.
        Fusión de alta concentración y dosificación precisa limpia, imitando los estándares
        de empaque premium globales.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {products.map((product) => (
        <div
          class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group"
        >
          <div>
            <Image
              src={product.image}
              alt={`Cultivar paste ${product.npk}`}
              widths={[172, 344]}
              sizes="172px"
              class="mx-auto py-2"
            />
            <div
              class:list={[
                "inline-flex items-center gap-1.5 px-2.5 py-1 rounded border text-xs font-bold uppercase tracking-wider mb-3",
                product.badge,
              ]}
            >
              <span class:list={["w-1.5 h-1.5 rounded-full", product.dot]}></span>
              {product.npk}
            </div>
            <h3
              class="text-lg font-bold text-ink group-hover:text-brand-green transition-colors duration-200 mb-2"
            >
              Cultivar paste {product.name}
            </h3>
            <p class="text-xs sm:text-sm text-muted mb-4">
              {product.description}
            </p>
          </div>
          <div class="my-2 border-t border-gray-200/60 pt-3">
            <p class="text-xs font-semibold text-ink mb-1">Aplicación:</p>
            <p class="text-xs text-body">{product.application}</p>
          </div>
          <a
            href={`${R2_URL}/${encodeURIComponent(product.pdf)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex justify-center gap-2 px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            Ver Datasheet (PDF)
          </a>
        </div>
      ))}

      <!-- Botón de contacto con asesor -->
      <div class="md:col-span-2 lg:col-span-4 flex items-center justify-center">
        <a
          href="#contact-form"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-green text-white font-bold text-sm sm:text-base tracking-wide shadow-md hover:shadow-lg transition-shadow duration-300"
        >
          <span>Contáctanos si necesitas más información</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
