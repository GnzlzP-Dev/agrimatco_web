---
import { Image } from "astro:assets";
import Acmopaste20_50_10 from "../../assets/products/20-50-10.png";
import Acmopaste5_50_30 from "../../assets/products/5-50-30.png";
import Acmopaste20_20_20 from "../../assets/products/20-20-20.png";
import Acmopaste15_20_50 from "../../assets/products/15-20-50.png";

const R2_URL = import.meta.env.PUBLIC_R2_URL;
const Acmopaste20_50_10_PDF = "MCFP Catalogue 15 20 50.pdf";
const Acmopaste5_50_30_PDF = "MCFP Catalogue 5 50 30.pdf";
const Acmopaste20_20_20_PDF = "MCFP Catalogue 20 20 20.pdf";
const Acmopaste15_20_50_PDF = "MCFP Catalogue 15 20 50.pdf";
---

<section
  id="productos"
  class="relative bg-white py-16 md:py-24 overflow-hidden scroll-mt-10"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-brand-green text-xs sm:text-sm font-bold tracking-widest uppercase block mb-2"
      >
        Portafolio de Alta Tecnología
      </span>
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#111827] tracking-tight mb-4"
      >
        Línea Cultivar paste: <span class="text-brand-green"
          >Nutrición Inteligente en Pasta</span
        >
      </h2>
      <p class="text-sm sm:text-base text-[#6B7280] leading-relaxed">
        La estructura física única de <strong>Cultivar paste</strong> ofrece una solubilidad
        superior y una asimilación inmediata, adaptándose a cualquier tipo de cultivo.
        Fusión de alta concentración y dosificación precisa limpia, imitando los estándares
        de empaque premium globales.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      <div
        class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group"
      >
        <div>
          <Image
            src={Acmopaste20_50_10}
            alt="Cultivar paste 20-50-10 + TE"
            widths={[172, 344]}
            sizes="172px"
            class="mx-auto py-2"
          />
          <div
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold uppercase tracking-wider mb-3"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            20-50-10 + TE
          </div>
          <h3
            class="text-lg font-bold text-[#111827] group-hover:text-brand-green transition-colors duration-200 mb-2"
          >
            Cultivar paste Enraizamiento
          </h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fertilizante en pasta de alta densidad con una concentración masiva
            de fósforo asimilable.
          </p>
        </div>
        <div class="mt-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">
            Etapas iniciales, trasplante y renovación radicular.
          </p>
        </div>
        <!-- Enlace directo limpio y sin código de servidor -->
        <a
          href={`${R2_URL}/${encodeURIComponent(Acmopaste20_50_10_PDF)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex justify-center gap-2 px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Ver Datasheet (PDF)
        </a>
      </div>

      <div
        class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group"
      >
        <div>
          <Image
            src={Acmopaste5_50_30}
            alt="Cultivar paste 5-50-30 + TE"
            widths={[172, 344]}
            sizes="172px"
            class="mx-auto py-2"
          />
          <div
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold uppercase tracking-wider mb-3"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
            5-50-30 + TE
          </div>
          <h3
            class="text-lg font-bold text-[#111827] group-hover:text-brand-green transition-colors duration-200 mb-2"
          >
            Cultivar paste Floración
          </h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fórmula cargada con un alto balance de fósforo y potasio altamente
            solubles.
          </p>
        </div>
        <div class="my-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">
            Prefloración, floración abierta y cuaje del fruto.
          </p>
        </div>

        <!-- Enlace directo limpio y sin código de servidor -->
        <a
          href={`${R2_URL}/${encodeURIComponent(Acmopaste5_50_30_PDF)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex justify-center gap-2 px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Ver Datasheet (PDF)
        </a>
      </div>

      <div
        class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group"
      >
        <div>
          <Image
            src={Acmopaste20_20_20}
            alt="Cultivar paste 20-20-20 + TE"
            widths={[172, 344]}
            sizes="172px"
            class="mx-auto py-2"
          />
          <div
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold uppercase tracking-wider mb-3"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
            20-20-20 + TE
          </div>
          <h3
            class="text-lg font-bold text-[#111827] group-hover:text-brand-green transition-colors duration-200 mb-2"
          >
            Cultivar paste Balanceado
          </h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fórmula equilibrada de NPK en partes iguales, enriquecida con
            micronutrientes.
          </p>
        </div>
        <div class="my-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">
            Crecimiento vegetativo y desarrollo foliar continuo.
          </p>
        </div>

        <!-- Enlace directo limpio y sin código de servidor -->
        <a
          href={`${R2_URL}/${encodeURIComponent(Acmopaste20_20_20_PDF)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex justify-center gap-2 px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Ver Datasheet (PDF)
        </a>
      </div>

      <div
        class="bg-gray-50 rounded-2xl border border-gray-100 p-5 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group"
      >
        <div>
          <Image
            src={Acmopaste15_20_50}
            alt="Cultivar paste 15-20-50 + TE"
            widths={[172, 344]}
            sizes="172px"
            class="mx-auto py-2"
          />
          <div
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-purple-50 border border-purple-200 text-purple-700 text-xs font-bold uppercase tracking-wider mb-3"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
            15-20-50 + TE
          </div>
          <h3
            class="text-lg font-bold text-[#111827] group-hover:text-brand-green transition-colors duration-200 mb-2"
          >
            Cultivar paste Llenado
          </h3>
          <p class="text-xs sm:text-sm text-[#6B7280] mb-4">
            Fertilizante en pasta con una concentración extrema de potasio
            soluble.
          </p>
        </div>
        <div class="my-2 border-t border-gray-200/60 pt-3">
          <p class="text-xs font-semibold text-[#111827] mb-1">Aplicación:</p>
          <p class="text-xs text-[#4B5563]">
            Fases de fructificación, engorde y maduración final.
          </p>
        </div>

        <!-- Enlace directo limpio y sin código de servidor -->
        <a
          href={`${R2_URL}/${encodeURIComponent(Acmopaste15_20_50_PDF)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex justify-center gap-2 px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Ver Datasheet (PDF)
        </a>
      </div>

      <!-- Boton de contacto con asesor -->
      <div class="lg:col-span-4 flex items-center justify-center">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-green text-white font-bold text-sm sm:text-base tracking-wide shadow-md hover:shadow-lg transition-shadow duration-300"
        >
          <span>Contáctanos si necesitas más información</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
