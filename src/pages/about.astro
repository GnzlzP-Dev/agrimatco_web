---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Nosotros | Agrimatco"
  description="Conoce a Agrimatco Colombia, empresa de fertilizantes en pasta y nutrición vegetal."
>
  <main class="pt-28 pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink tracking-tight mb-4">
        Nosotros
      </h1>
      <p class="text-sm sm:text-base text-muted leading-relaxed max-w-2xl">
        Próximamente.
      </p>
    </div>
  </main>
</Layout>
