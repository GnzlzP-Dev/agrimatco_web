---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Coverage from '../components/Coverage.astro';
import Products from '../components/Products.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Agrimatco | Fertilizantes en Pasta y Nutrición Vegetal de Alta Eficiencia">
  <main class="overflow-hidden">
    <Hero />
    <Features />
    <Coverage />
    <Products />
    <FAQ />
    <Footer />
  </main>
</Layout>

<script is:inline>
  // Ocultar wrap de Netlify en la página de inicio
  const netlifyWrap = document.querySelector('#nl-badge-frame');
  if (netlifyWrap) {
    netlifyWrap.style.display = 'none';
  }
</script>
