---
import { CldUploadWidget } from 'astro-cloudinary';
import '../styles/global.css';

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET;
const uploaderConfigured = Boolean(cloudName && uploadPreset);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f5f8f5" />
    <title>Cargar fotos | Agrimatco</title>
    <meta name="description" content="Carga de imágenes para la galería de Agrimatco." />
  </head>
  <body class="min-h-screen bg-[#f5f8f5] font-sans text-brand-dark antialiased">
    <main class="relative isolate flex min-h-screen flex-col overflow-hidden px-4 py-6 sm:px-6 sm:py-10">
      <div class="pointer-events-none absolute -right-32 -top-40 -z-10 h-[30rem] w-[30rem] rounded-full bg-brand-green/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-48 -left-32 -z-10 h-[34rem] w-[34rem] rounded-full bg-emerald-200/30 blur-3xl"></div>



      <section class="mx-auto my-auto w-full max-w-2xl py-12 sm:py-16">
        <div class="mb-7 text-center sm:mb-9">
          <span class="mb-4 inline-flex items-center gap-2 rounded-full bg-brand-green/10 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-[#08772c]">
            Portal de contenido
          </span>
          <h1 class="text-3xl font-extrabold tracking-tight text-[#18231b] sm:text-4xl">
            Comparte tus fotos
          </h1>
          <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-gray-600 sm:text-base">
            Selecciona las imágenes que quieres enviar para la galería de Agrimatco.
            Puedes cargar varias a la vez.
          </p>
        </div>

        <div class="rounded-3xl border border-gray-200/80 bg-white p-4 shadow-[0_24px_80px_-32px_rgba(26,61,37,0.24)] sm:p-8">

          {
            uploaderConfigured ? (
              <CldUploadWidget
                id="agrimatco-upload-widget"
                uploadPreset={uploadPreset}
                options={{
                  folder: 'AGRIMATCO',
                  resourceType: 'image',
                  multiple: true,
                  maxFiles: 20,
                  maxFileSize: 10 * 1024 * 1024,
                  clientAllowedFormats: ['jpg', 'jpeg', 'png', 'webp', 'avif'],
                  sources: ['local', 'camera', 'url', 'google_drive', 'dropbox', 'instagram'],
                  language: 'es',
                  showAdvancedOptions: true,
                  showUploadMoreButton: true,
                  showPoweredBy: false,
                }}
              >
                <button
                  type="button"
                  class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-green px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:bg-[#07962f] focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-green/25"
                >
                  <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
                    <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 15.5v2A2.5 2.5 0 0 0 7.5 20h9a2.5 2.5 0 0 0 2.5-2.5v-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  Abrir cargador de imágenes
                </button>
              </CldUploadWidget>
            ) : (
              <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900" role="status">
                La carga aún no está configurada. Define el nombre de Cloudinary y el preset
                unsigned en las variables de entorno.
              </div>
            )
          }

          <p class="mt-3 text-center text-xs leading-5 text-gray-500">
            Para ponerle un nombre a cada foto, abre <strong>Opciones avanzadas</strong> en el widget
            y completa el campo <strong>ID público</strong> antes de cargarla.
          </p>

          <div
            id="upload-feedback"
            class="mt-5 hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm leading-6 text-emerald-900"
            role="status"
            aria-live="polite"
          ></div>


        </div>


      </section>

      <footer class="mx-auto flex w-full max-w-5xl items-center justify-between border-t border-gray-200/80 pt-4 text-[11px] text-gray-500">
        <span>Agrimatco Colombia S.A.S.</span>
        <a href="/" class="rounded underline decoration-gray-300 underline-offset-4 hover:text-brand-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green">Volver al sitio</a>
      </footer>
    </main>

    <script>
      const uploadWidget = document.querySelector('#agrimatco-upload-widget');
      const feedback = document.querySelector('#upload-feedback');
      let uploadedCount = 0;

      if (uploadWidget instanceof HTMLElement && feedback instanceof HTMLDivElement) {
        uploadWidget.addEventListener('clduploadwidget:success', () => {
          uploadedCount += 1;
          feedback.textContent = `${uploadedCount} imagen${uploadedCount === 1 ? '' : 'es'} cargada${uploadedCount === 1 ? '' : 's'} correctamente. Aparecerá${uploadedCount === 1 ? '' : 'n'} en la galería después de la siguiente publicación del sitio.`;
          feedback.classList.remove('hidden');
        });

        uploadWidget.addEventListener('clduploadwidget:error', () => {
          feedback.textContent = 'No se pudo completar una carga. Revisa el mensaje del widget e inténtalo de nuevo.';
          feedback.classList.remove('hidden', 'border-emerald-200', 'bg-emerald-50', 'text-emerald-900');
          feedback.classList.add('border-red-200', 'bg-red-50', 'text-red-800');
        });
      }
    </script>
  </body>
</html>
